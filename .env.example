# FreeVPS Mark1.3 - Environment Configuration
# Copy this to .env and customize

# VPS Credentials (as requested)
VPS_USER=Mikasa
VPS_PASS=Eren@Home$123
VPS_USER_LOWER=mikasa

# Ports
PORT=8080
MAIN_PORT=8080
TTYD_PORT=7681
CODE_PORT=8081
SSH_PORT=22

# Optional: Tailscale for persistent VPN access (24/7 SSH)
# Get auth key from https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=

# Optional: Ngrok for exposing local ports
# Get token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=

# Optional: GitHub PAT for auto-restart workflow (for true 24/7)
# Create PAT with workflow scope and add as GH_PAT secret
GH_PAT=

# Session secret for dashboard (change in production)
SESSION_SECRET=freevps-mark1-3-secret-key-eren-mikasa-2024-change-me

# Node env
NODE_ENV=production
