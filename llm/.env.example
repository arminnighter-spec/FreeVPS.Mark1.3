# FreeVPS Mark1.3 - Hermes LLM + LiteLLM Router - Env

# Ollama
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_ORIGINS=*
OLLAMA_MODELS=nous-hermes2,hermes3:8b,openhermes
# For GitHub Actions (low RAM), use smaller models
OLLAMA_MODELS_LIGHT=nous-hermes2:2b,hermes3:3b

# LiteLLM Proxy
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-1234
LITELLM_SALT_KEY=sk-salt-1234
LITELLM_DATABASE_URL=sqlite:////app/data/litellm.db

# Optional: External API fallbacks (if Ollama down, fallback to these)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=...
GROQ_API_KEY=...
TOGETHER_API_KEY=...

# Custom Router
ROUTER_PORT=4001
ROUTER_MASTER_KEY=sk-1234

# Open WebUI
WEBUI_PORT=3000
WEBUI_NAME=FreeVPS Hermes - Mikasa

# VPS Auth (for dashboard integration)
VPS_USER=Mikasa
VPS_PASS=Eren@Home$123

# 24/7 Monitoring
UPTIME_PING_URL=
SLACK_WEBHOOK_URL=

# Model selection
DEFAULT_MODEL=hermes
DEFAULT_MODEL_LIGHT=hermes3:3b
DEFAULT_MODEL_HEAVY=hermes3:8b
